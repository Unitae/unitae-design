{
  "name": "@unitae/tokens",
  "version": "0.1.0",
  "description": "Design tokens for Unitae: colours, type, radius, motion and chart palettes as CSS variables, a Tailwind v4 theme and a JS API.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unitae/unitae-design.git",
    "directory": "tokens"
  },
  "keywords": [
    "design-tokens",
    "tailwindcss",
    "shadcn",
    "unitae"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./base.css": "./dist/base.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.ts && tsc6 -p tsconfig.build.json",
    "test": "vitest run",
    "test:typecheck": "tsc6 --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "peerDependencies": {
    "@fontsource/ibm-plex-sans": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@fontsource/ibm-plex-sans": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/node": "^24.19.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
